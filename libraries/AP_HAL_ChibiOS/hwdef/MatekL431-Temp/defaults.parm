# Four MCP9601s on I2C2 (bus 0). SRC 6 publishes uavcan.equipment.device.Temperature.
# SRC_ID is the DroneCAN device_id and matches the FC battery serials.
TEMP_MSG_RATE 10

TEMP1_TYPE 2
TEMP1_BUS 0
TEMP1_ADDR 96
TEMP1_SRC 6
TEMP1_SRC_ID 4

TEMP2_TYPE 2
TEMP2_BUS 0
TEMP2_ADDR 100
TEMP2_SRC 6
TEMP2_SRC_ID 5

TEMP4_TYPE 2
TEMP4_BUS 0
TEMP4_ADDR 102
TEMP4_SRC 6
TEMP4_SRC_ID 6

TEMP5_TYPE 2
TEMP5_BUS 0
TEMP5_ADDR 103
TEMP5_SRC 6
TEMP5_SRC_ID 7
