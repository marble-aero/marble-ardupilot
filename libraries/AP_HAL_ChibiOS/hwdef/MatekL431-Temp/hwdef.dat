include ../MatekL431/hwdef.inc

# MCP9600/MCP9601 only. Stock MatekL431-Periph leaves temperature compiled
# out, and the 256KB part cannot add it on top of GPS/mag/baro/airspeed.

define HAL_USE_ADC FALSE
define STM32_ADC_USE_ADC1 FALSE
define HAL_DISABLE_ADC_DRIVER TRUE

define HAL_NO_RCOUT_THREAD
define HAL_NO_TIMER_THREAD
undef HAL_RCIN_THREAD_ENABLED
define HAL_RCIN_THREAD_ENABLED 0

define AP_PERIPH_GPS_ENABLED 0
define AP_PERIPH_MAG_ENABLED 0
define AP_PERIPH_BARO_ENABLED 0
define AP_PERIPH_AIRSPEED_ENABLED 0
define AP_PERIPH_MSP_ENABLED 0
define AP_PERIPH_RC_OUT_ENABLED 0
define AP_PERIPH_NOTIFY_ENABLED 0
define AP_PERIPH_BATTERY_ENABLED 0

define AP_PERIPH_DEVICE_TEMPERATURE_ENABLED 1
define AP_TEMPERATURE_SENSOR_ENABLED 1
define AP_TEMPERATURE_SENSOR_BACKEND_DEFAULT_ENABLED 0
define AP_TEMPERATURE_SENSOR_MCP9600_ENABLED 1
define AP_TEMPERATURE_SENSOR_DRONECAN_ENABLED 0
define AP_TEMPERATURE_SENSOR_TSYS01_ENABLED 0
define AP_TEMPERATURE_SENSOR_TSYS03_ENABLED 0
# TEMP5 is instance index 4
define AP_TEMPERATURE_SENSOR_MAX_INSTANCES 5

USE_BOOTLOADER_FROM_BOARD MatekL431
